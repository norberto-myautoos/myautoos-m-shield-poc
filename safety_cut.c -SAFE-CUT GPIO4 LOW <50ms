#include "vcu_mshield.h"
#include <Arduino.h>

void safety_cut_init(void) {
  pinMode(PIN_CAN_INT, OUTPUT); // GPIO4 = SAFE-CUT
  digitalWrite(PIN_CAN_INT, HIGH); // Inactivo = HIGH, activo = LOW
  Serial.println("SAFE-CUT Init - GPIO4 HIGH - Ready <50ms");
}

void safety_cut_check_soc(uint8_t soc) {
  // Si SOC < 20% - Corta Cell 34 1A 0.8k en <50ms
  if (soc < SOC_CUT_THRESHOLD) {
    uint32_t t0 = millis();
    digitalWrite(PIN_CAN_INT, LOW); // SAFE-CUT ACTIVO
    uint32_t dt = millis() - t0;
    
    Serial.print("SAFE-CUT! SOC=");
    Serial.print(soc);
    Serial.print("% <20% -> GPIO4 LOW - Time: ");
    Serial.print(dt);
    Serial.println("ms <50ms OK - Cell34 1A 0.8k");
    
    // OTA dual partition - safe reboot si es necesario
    // No bloqueante - ASIL-D
  } else {
    digitalWrite(PIN_CAN_INT, HIGH); // Normal
  }
}
